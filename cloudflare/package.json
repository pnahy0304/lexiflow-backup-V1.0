{
  "name": "lexiflow-api",
  "version": "1.0.0",
  "description": "LexiFlow Cloudflare Worker API with D1 database",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute lexiflow-db --file=src/db/schema.sql",
    "db:init:local": "wrangler d1 execute lexiflow-db --local --file=src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.5",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.10.0"
  }
}
